--- /dev/null
+++ b/fs/cq_log.c
@@ -0,0 +1,44 @@
+// SPDX-License-Identifier: GPL-2.0
+#include <linux/cq_log.h>
+#include <linux/fs.h>
+#include <linux/slab.h>
+#include <linux/uaccess.h>
+#include <linux/dcache.h>
+#include <linux/path.h>
+#include <linux/moduleparam.h>
+
+int cq_log_uid = 0;
+core_param(cq_log_uid, cq_log_uid, int, 0644);
+
+void cq_log_upath(const char *op, const char __user *pathname)
+{
+	char *buf;
+	long n;
+
+	if (!pathname) {
+		pr_info("cq: %s (null)\n", op);
+		return;
+	}
+	buf = kmalloc(PATH_MAX, GFP_KERNEL);
+	if (!buf)
+		return;
+	n = strncpy_from_user(buf, pathname, PATH_MAX - 1);
+	if (n > 0) {
+		buf[n] = '\0';
+		pr_info("cq: %s %s\n", op, buf);
+	}
+	kfree(buf);
+}
+
+void cq_log_fpath(const char *op, struct file *file)
+{
+	char *buf, *p;
+
+	buf = kmalloc(PATH_MAX, GFP_KERNEL);
+	if (!buf)
+		return;
+	p = d_path(&file->f_path, buf, PATH_MAX);
+	if (!IS_ERR(p))
+		pr_info("cq: %s %s\n", op, p);
+	kfree(buf);
+}
--- /dev/null
+++ b/include/linux/cq_log.h
@@ -0,0 +1,24 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * cq_log - syscall path logger for diagnosis
+ * Enable via /sys/module/kernel/parameters/cq_log_uid (0 = off).
+ * Logs open/statx/readdir paths of the matched uid into dmesg.
+ */
+#ifndef _LINUX_CQ_LOG_H
+#define _LINUX_CQ_LOG_H
+
+#include <linux/kernel.h>
+#include <linux/cred.h>
+
+extern int cq_log_uid;
+
+static inline bool cq_log_match(void)
+{
+	return cq_log_uid != 0 &&
+		from_kuid(&init_user_ns, current_uid()) == cq_log_uid;
+}
+
+void cq_log_upath(const char *op, const char __user *pathname);
+void cq_log_fpath(const char *op, struct file *file);
+
+#endif /* _LINUX_CQ_LOG_H */
