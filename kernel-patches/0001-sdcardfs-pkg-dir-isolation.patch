 		appid_t value)
 {
diff --git a/fs/sdcardfs/lookup.c b/fs/sdcardfs/lookup.c
--- a/fs/sdcardfs/lookup.c
+++ b/fs/sdcardfs/lookup.c
@@ -421,6 +421,12 @@
 
 	parent = dget_parent(dentry);
 
+	/* 非属主看不到 Android/{data,obb}/<包名>：按"不存在"处理 */
+	if (sdcardfs_pkg_dir_hidden(d_inode(parent), &dentry->d_name)) {
+		ret = ERR_PTR(-ENOENT);
+		goto out_err;
+	}
+
 	if (!check_caller_access_to_name(d_inode(parent), &dentry->d_name)) {
 		ret = ERR_PTR(-EACCES);
 		goto out_err;
diff --git a/fs/sdcardfs/dentry.c b/fs/sdcardfs/dentry.c
--- a/fs/sdcardfs/dentry.c
+++ b/fs/sdcardfs/dentry.c
@@ -55,6 +55,17 @@
 	}
 
 	parent_dentry = dget_parent(dentry);
+
+	/*
+	 * 与 sdcardfs_lookup 保持一致。dcache 是全局共享的，属主自己访问过后
+	 * dentry 会留在缓存里，路径解析会直接命中而不进 ->lookup；
+	 * 因此这里必须同样拦一次，否则检测方可以靠缓存绕过。
+	 */
+	if (sdcardfs_pkg_dir_hidden(d_inode(parent_dentry), &dentry->d_name)) {
+		dput(parent_dentry);
+		return -ENOENT;
+	}
+
 	sdcardfs_get_lower_path(parent_dentry, &parent_lower_path);
 	sdcardfs_get_real_lower(dentry, &lower_path);
 	parent_lower_dentry = parent_lower_path.dentry;
