+/*
+ * 包目录隔离（自研）
+ *
+ * 原生行为：sdcardfs 只在 readdir 时过滤 /Android/data 下其他包的目录，
+ * 但对"已知包名的具体路径"的 stat / open 一律放行（get_mode() 给 Android
+ * 目录保留了 other +x）。于是任意普通应用只要猜包名，就能确认目标应用
+ * 是否安装 —— 这正是检测类 App 常用的手法，且完全绕过 pm 层隐藏。
+ *
+ * 这里让"非属主的普通应用"在查找 Android/data/<包名> 与
+ * Android/obb/<包名> 时直接得到 ENOENT，与"该应用未安装"不可区分
+ * （刻意不用 EACCES：EACCES 等于告诉对方"存在但被拒"）。
+ *
+ * 放行：
+ *   1. uid < 10000 的系统身份（root / system / shell / media_rw / installd 等）
+ *   2. 目录属主自身（自己的 Android/data 完全不受影响）
+ *   3. sdcardfs.pkg_iso_allow 白名单里的 uid（运行时可写，无需重新编译）
+ */
+#define SDCARDFS_AID_APP_START	10000
+
+static char *sdcardfs_pkg_iso_allow = "";
+module_param_named(pkg_iso_allow, sdcardfs_pkg_iso_allow, charp, 0644);
+MODULE_PARM_DESC(pkg_iso_allow,
+	"Comma separated uids allowed to see other apps' Android/data and Android/obb");
+
+static bool sdcardfs_pkg_iso_debug;
+module_param_named(pkg_iso_debug, sdcardfs_pkg_iso_debug, bool, 0644);
+MODULE_PARM_DESC(pkg_iso_debug, "Log pkg-isolation decisions (default off)");
+
+static bool sdcardfs_uid_allowlisted(uid_t uid)
+{
+	const char *p = sdcardfs_pkg_iso_allow;
+
+	if (!p)
+		return false;
+
+	while (*p) {
+		unsigned long v = 0;
+		bool has_digit = false;
+
+		while (*p == ',' || *p == ' ' || *p == '\t' || *p == '\n')
+			p++;
+		while (*p >= '0' && *p <= '9') {
+			v = v * 10 + (*p - '0');
+			has_digit = true;
+			p++;
+		}
+		if (has_digit && (uid_t)v == uid)
+			return true;
+		while (*p && *p != ',')
+			p++;
+	}
+	return false;
+}
+
+bool sdcardfs_pkg_dir_hidden(struct inode *parent_node, const struct qstr *name)
+{
+	struct sdcardfs_inode_data *pd;
+	uid_t caller;
+	appid_t appid;
+	uid_t owner;
+	struct qstr key;
+
+	if (!parent_node || !name)
+		return false;
+
+	pd = SDCARDFS_I(parent_node)->data;
+	if (!pd)
+		return false;
+
+	/* 只处理 /Android/data/<包名> 与 /Android/obb/<包名> 这一层 */
+	if (pd->perm != PERM_ANDROID_DATA && pd->perm != PERM_ANDROID_OBB)
+		return false;
+
+	caller = from_kuid(&init_user_ns, current_fsuid());
+
+	/* 系统身份一律放行，避免影响 installd / vold / MediaProvider / shell */
+	if (caller < SDCARDFS_AID_APP_START)
+		return false;
+
+	if (sdcardfs_uid_allowlisted(caller))
+		return false;
+
+	/*
+	 * 注意：不能直接用 dentry->d_name 的 hash 去查表 —— 那份 hash 来自
+	 * VFS 的 nd->last（按字节算），和 packagelist 建表时用的
+	 * full_name_case_hash（大小写无关）不是同一套。名字里只要有一个
+	 * 大写字母就查不到，appid 会变成 0，属主判定随之失效（连自己的目录
+	 * 也会被误拦）。这里统一按建表规则重算一次。
+	 */
+	key.name = name->name;
+	key.len = name->len;
+	key.hash = full_name_case_hash(0, key.name, key.len);
+
+	appid = __get_appid(&key);
+	owner = appid ? multiuser_get_uid(pd->userid, appid) : 0;
+
+	if (sdcardfs_pkg_iso_debug) {
+		pr_info("sdcardfs-iso: caller=%u name=%.*s appid=%u owner=%u perm=%d userid=%u -> hide=%d\n",
+			caller, name->len, name->name, appid, owner,
+			(int)pd->perm, (unsigned)pd->userid,
+			(appid && owner != caller) ? 1 : 0);
+	}
+
+	return appid && owner != caller;
+}
+
